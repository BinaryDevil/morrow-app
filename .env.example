# Copy this file to .env and fill in the values from your Supabase project settings.
# These values are safe to expose to the mobile client only when Row Level Security
# policies protect every table and storage bucket.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never put SUPABASE_SERVICE_ROLE_KEY or a PostgreSQL connection string in this file.
# Those are server-only secrets and must never ship inside the Expo app.
